# ClubPulse — Environment Variables Example
# Duplicate this file to .env.local and populate with your credentials

# -------------------------------------------------------------
# 1. MongoDB Connection (Optional for local testing, persistent)
# -------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/clubpulse

# -------------------------------------------------------------
# 2. Application Base URL & Session Security
# -------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
NODE_ENV=development

# -------------------------------------------------------------
# 3. Firebase Client Web SDK Configuration
# (Obtain from: Firebase Console -> Project Settings -> General -> Your apps -> Web app)
# -------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyExampleKeyFromFirebaseConsole
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=clubpulse-campus.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=clubpulse-campus
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=clubpulse-campus.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# -------------------------------------------------------------
# 4. Backend Admin / Dean Role Authorization
# (Comma-separated list of campus emails authorized for Admin / Dean access)
# IMPORTANT: New registrations always default to student role. Admin access
# can only be authorized by university administration via this whitelist.
# -------------------------------------------------------------
ADMIN_EMAILS=marcus.vance@campus.edu,dean@campus.edu,admin@campus.edu
